#!/bin/sh

die () { echo "$@" >&2; exit 1; }

\. ../../nvm.sh

NVM_TEST_VERSION=v0.10.7

# Keep one real source build with an explicit job count. The fast test
# "nvm install passes explicit make jobs" checks both argument orders and
# the actual make arguments, including the single-job case.
nvm deactivate || die 'deactivate failed'
if nvm_is_version_installed "${NVM_TEST_VERSION}"; then
  nvm uninstall "${NVM_TEST_VERSION}" || die 'uninstall failed'
fi

nvm install -j 2 -s "${NVM_TEST_VERSION}" || die "'nvm install -j 2 -s ${NVM_TEST_VERSION}' failed"

nvm_is_version_installed "${NVM_TEST_VERSION}" || die 'version not installed'
ACTUAL="$(nvm run --silent "${NVM_TEST_VERSION}" --version)" || die 'installed node failed'
[ "${ACTUAL}" = "${NVM_TEST_VERSION}" ] || die "unexpected node version: ${ACTUAL}"
