#!/bin/sh

die () { echo "$@" ; exit 1; }

. ../../nvm.sh

nvm_ls() {
  echo "       v16.20.2"
  echo "       v18.20.5"
  echo "       v18.20.7"
  echo "       v20.17.0"
  echo "->     v22.22.0"
  echo "       v24.13.0"
}

# Ignore any aliases in the real NVM_DIR.
nvm_alias_path() {
  echo /nonexistent
}

nvm_ls_current() {
  echo "v22.22.0"
}

nvm_is_version_installed() {
  return 0
}

UNINSTALLED_VERSIONS=""
nvm() {
  if [ "$1" = "uninstall" ]; then
    UNINSTALLED_VERSIONS="${UNINSTALLED_VERSIONS} $2"
    return 0
  fi
  echo "nvm called with unexpected args: $*"
}

nvm_prune --force

EXPECTED=" v18.20.5"
if [ "${UNINSTALLED_VERSIONS}" != "${EXPECTED}" ]; then
  die "Expected uninstalled: '${EXPECTED}', got: '${UNINSTALLED_VERSIONS}'"
fi

# The current version is kept even when it is not the newest.
nvm_ls() {
  echo "       v18.0.0"
  echo "->     v18.1.0"
  echo "       v18.2.0"
}

nvm_ls_current() {
  echo "v18.1.0"
}

UNINSTALLED_VERSIONS=""
nvm_prune --force

EXPECTED=" v18.0.0"
if [ "${UNINSTALLED_VERSIONS}" != "${EXPECTED}" ]; then
  die "current version case: expected uninstalled: '${EXPECTED}', got: '${UNINSTALLED_VERSIONS}'"
fi

# Versions compare numerically, not lexically.
nvm_ls() {
  echo "       v18.10.0"
  echo "       v18.9.0"
  echo "       v18.9.10"
  echo "       v18.9.2"
}

nvm_ls_current() {
  echo "none"
}

UNINSTALLED_VERSIONS=""
nvm_prune --force

EXPECTED=" v18.9.0 v18.9.2 v18.9.10"
if [ "${UNINSTALLED_VERSIONS}" != "${EXPECTED}" ]; then
  die "numeric order case: expected uninstalled: '${EXPECTED}', got: '${UNINSTALLED_VERSIONS}'"
fi

for VAR in NVM_PRUNE_ARG NVM_DRY_RUN NVM_FORCE NVM_KEEP_MINOR NVM_CANDIDATES NVM_PROTECTED NVM_ALIAS_DIR NVM_ALIAS_FILE NVM_PRUNE_VERSION NVM_VERSION_PATH NVM_GLOBALS_DIR NVM_GLOBAL NVM_GLOBALS_COUNT NVM_REMOVE NVM_REMOVE_LIST NVM_ANSWER NVM_REMOVED_COUNT NVM_FAILED_COUNT; do
  eval "[ -z \"\${${VAR}+set}\" ]" || die "nvm_prune leaked ${VAR}"
done

echo "All tests passed"
