#!/bin/sh

die () { echo "$@" ; exit 1; }

. ../../nvm.sh

nvm_ls() {
  echo "       v18.20.5"
  echo "       v18.20.7"
}

nvm_ls_current() {
  echo "none"
}

nvm_is_version_installed() {
  return 0
}

UNINSTALLED_VERSIONS=""
nvm() {
  if [ "$1" = "uninstall" ]; then
    UNINSTALLED_VERSIONS="${UNINSTALLED_VERSIONS} $2"
    return 0
  fi
  echo "nvm called with unexpected args: $*"
}

echo "n" > answer_no.tmp
echo "y" > answer_yes.tmp

# Declining the prompt must leave every version installed.
UNINSTALLED_VERSIONS=""
nvm_prune < answer_no.tmp
EXIT_CODE=$?
[ "${EXIT_CODE}" -eq 0 ] || die "declining the prompt should exit 0, got ${EXIT_CODE}"
[ -z "${UNINSTALLED_VERSIONS}" ] || die "declining the prompt should not uninstall anything, got: '${UNINSTALLED_VERSIONS}'"

# Accepting the prompt must perform the deletion.
UNINSTALLED_VERSIONS=""
nvm_prune < answer_yes.tmp
EXPECTED=" v18.20.5"
[ "${UNINSTALLED_VERSIONS}" = "${EXPECTED}" ] || die "accepting the prompt: expected uninstalled '${EXPECTED}', got '${UNINSTALLED_VERSIONS}'"

rm -f answer_no.tmp answer_yes.tmp

echo "All tests passed"
