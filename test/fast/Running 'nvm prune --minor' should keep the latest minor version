#!/bin/sh

die () { echo "$@" ; exit 1; }

. ../../nvm.sh

# With --minor, grouping is per major.minor instead of per major: v18.20.5
# and v18.20.7 share a minor (keep only v18.20.7), while v18.21.0 is a
# separate minor and must be kept too.
nvm_ls() {
  echo "       v18.20.5"
  echo "       v18.20.7"
  echo "       v18.21.0"
}

nvm_ls_current() {
  echo "none"
}

nvm_is_version_installed() {
  return 0
}

UNINSTALLED_VERSIONS=""
nvm() {
  if [ "$1" = "uninstall" ]; then
    UNINSTALLED_VERSIONS="${UNINSTALLED_VERSIONS} $2"
    return 0
  fi
  echo "nvm called with unexpected args: $*"
}

nvm_prune --minor --force

EXPECTED=" v18.20.5"
if [ "${UNINSTALLED_VERSIONS}" != "${EXPECTED}" ]; then
  die "Expected uninstalled: '${EXPECTED}', got: '${UNINSTALLED_VERSIONS}'"
fi

echo "All tests passed"
