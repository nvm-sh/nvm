#!/bin/sh

# Regression test for https://github.com/nvm-sh/nvm/issues/3584
#
# A caller (very often a CI build script) may have readonly variables, most
# notably `readonly VERSION=...` used to pin a version. When nvm.sh declared
# a local of the same name while being sourced, bash rejected the declaration
# and dash aborted the script outright, so sourcing failed and the build
# broke. Every unprefixed local name nvm.sh declares is derived from nvm.sh
# itself here, so adding a new unprefixed local to the sourcing path fails
# this test instead of failing the user's shell.
#
# For every name the test also checks that sourcing still activates the
# default alias: the startup path runs `nvm use`, and silently exiting 0
# without selecting anything was a regression found during review.

die () { echo "$@" ; exit 1; }

NVM_SH_PATH="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)/nvm.sh"
[ -r "${NVM_SH_PATH}" ] || die "cannot find nvm.sh at ${NVM_SH_PATH}"

# The shell urchin is running this test in.
if [ -n "${BASH_VERSION-}" ]; then
  NVM_TEST_SHELL=bash
elif [ -n "${ZSH_VERSION-}" ]; then
  NVM_TEST_SHELL=zsh
elif [ -n "${KSH_VERSION-}" ]; then
  NVM_TEST_SHELL=mksh
else
  NVM_TEST_SHELL=sh
fi
command -v "${NVM_TEST_SHELL}" >/dev/null 2>&1 || die "shell ${NVM_TEST_SHELL} is not available"

NVM_TEST_DIR="$(mktemp -d)" || die 'could not create a temporary directory'
cleanup () {
  [ -n "${NVM_TEST_DIR}" ] && rm -rf "${NVM_TEST_DIR}"
}

# A fixture with an installed version and a default alias, so that sourcing
# runs the startup `nvm use` and has something to activate.
NVM_FAKE_DIR="${NVM_TEST_DIR}/nvm"
mkdir -p "${NVM_FAKE_DIR}/versions/node/v14.21.3/bin" "${NVM_FAKE_DIR}/alias" || die 'fixture setup failed'
printf '#!/bin/sh\necho v14.21.3\n' > "${NVM_FAKE_DIR}/versions/node/v14.21.3/bin/node"
chmod +x "${NVM_FAKE_DIR}/versions/node/v14.21.3/bin/node"
command printf 'v14.21.3' > "${NVM_FAKE_DIR}/alias/default"
# the startup `nvm use --only=alpha,lts,non-lts,iojs` refuses to run without
# recorded LTS status, so provide the file a real environment has after the
# first `nvm ls-remote`
touch "${NVM_FAKE_DIR}/.lts-status"
# populate with the shape a real  records, so the startup
# --only classification has real data to work with
# the startup  classifies the default
# version through this file, so provide the minimal shape a real
#  records
command printf 'v1.0.0 -
v14.21.3 -
' > "/.lts-status"

# Every unprefixed local name nvm.sh declares. NVM_-prefixed locals are nvm's
# own namespace and are excluded; IFS, PREFIX and TMPDIR are shell or install
# contracts that a caller may reasonably make readonly, and nvm cannot use
# other names for them.
NVM_NAMES="$(sed -nE 's/^[[:space:]]*local[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)([[:space:]]*=?).*/\1/p' "${NVM_SH_PATH}" \
  | command grep -v '^NVM_' | command sort -u \
  | command grep -vE '^(IFS|PREFIX|TMPDIR)$')"

[ -n "${NVM_NAMES}" ] || die 'could not derive local names from nvm.sh'

for NVM_NAME in ${NVM_NAMES}; do
  NVM_GOT="$(cd "${NVM_TEST_DIR}" && env -i \
    PATH="${PATH}" HOME="${HOME}" NVM_DIR="${NVM_FAKE_DIR}" \
    "${NVM_TEST_SHELL}" -c "
      readonly ${NVM_NAME}=caller_value
      . '${NVM_SH_PATH}'
      nvm current
    " 2>/dev/null)"

  [ "${NVM_GOT}" = 'v14.21.3' ] || \
    die "with readonly ${NVM_NAME}, sourcing nvm.sh did not activate the default version in ${NVM_TEST_SHELL}: got >${NVM_GOT}<"
done

cleanup
