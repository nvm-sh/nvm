#!/bin/sh

ORIG_NVM_DIR="${NVM_DIR}"
TMP_DIR=''

cleanup () {
  case "${TMP_DIR}" in
    /*) rm -rf "${TMP_DIR}" ;;
  esac
  NVM_DIR="${ORIG_NVM_DIR}"
  export NVM_DIR
  unset -f nvm_npm_global_modules nvm_ls_current
}

die () { echo "$@" ; cleanup ; exit 1; }

: nvm.sh
\. ../../../nvm.sh

\. ../../common.sh

TMP_DIR="$(mktemp -d)"
NVM_DIR="${TMP_DIR}/nvm"
export NVM_DIR

make_fake_node v20.0.0 || die 'fake node v20.0.0 could not be made'
nvm_ls_current() { echo 'v18.0.0'; }
nvm_npm_global_modules() { echo ' //// '; }

try_err nvm reinstall-packages 99
[ "_${CAPTURED_EXIT_CODE}" = '_3' ] || die "nvm reinstall-packages 99 exited ${CAPTURED_EXIT_CODE}, expected 3"
EXPECTED="Version '99' is not installed."
[ "_${CAPTURED_STDERR}" = "_${EXPECTED}" ] || die "nvm reinstall-packages 99 printed >${CAPTURED_STDERR}< to stderr, expected >${EXPECTED}<"

try nvm reinstall-packages 99
[ -z "${CAPTURED_STDOUT}" ] || die "nvm reinstall-packages 99 printed >${CAPTURED_STDOUT}< to stdout, expected nothing"

# an installed version still reinstalls
OUTPUT="$(nvm reinstall-packages 20 2>&1)" || die "nvm reinstall-packages 20 failed: >${OUTPUT}<"
EXPECTED='Reinstalling global packages from v20.0.0...
No installed global packages found...
Linking global packages from v20.0.0...
No linked global packages found...'
[ "_${OUTPUT}" = "_${EXPECTED}" ] || die "nvm reinstall-packages 20 printed >${OUTPUT}<, expected >${EXPECTED}<"

cleanup
